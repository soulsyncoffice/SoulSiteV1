# Server-only values. SUPABASE_SERVICE_ROLE_KEY is highly privileged and must
# never be prefixed with VITE_ or exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser build-time values. The anon/publishable key is safe to expose when
# Row Level Security is enabled; private table grants remain server-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only OpenAI API key for explicitly consented SoulMind overview
# generation. The default model may be overridden if your account uses another.
OPENAI_API_KEY=
SOULSITE_OVERVIEW_MODEL=gpt-4.1-mini
